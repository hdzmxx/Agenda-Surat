#--------------------------------------------------------------------
# CONTOH PENGATURAN. Salin berkas ini menjadi ".env" lalu sesuaikan.
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
# Berkas ".env" berisi kata sandi database dan TIDAK boleh masuk ke Git
# (sudah dikecualikan di .gitignore).
#--------------------------------------------------------------------

# "development" saat mencoba (kesalahan ditampilkan rinci),
# "production" saat dipakai sungguhan.
CI_ENVIRONMENT = development

# Alamat aplikasi, diakhiri garis miring. Contoh produksi: 'https://surat.sekolah.sch.id/'
app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE (MySQL / MariaDB)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = xagenda
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# IDENTITAS SEKOLAH (dipakai pada kop dan isi surat)
# Nilai KOP_*, INSTANSI, ALAMAT, dan TTD_* hanyalah nilai awal. Setelah
# aplikasi berjalan, admin bisa mengubahnya di menu "Pengaturan kop surat".
# Pada ALAMAT, tanda | memisahkan baris.
#--------------------------------------------------------------------
NAMA_SEKOLAH = 'SMP Negeri Contoh'
INSTANSI = 'SMP NEGERI CONTOH'
KOP_PEMERINTAH = 'PEMERINTAH KABUPATEN CONTOH'
KOP_DINAS = 'DINAS PENDIDIKAN, KEPEMUDAAN DAN OLAHRAGA'
ALAMAT = 'Jalan Contoh No. 1, Kabupaten Contoh, Kode Pos: 00000, Telp. (0000) 000000|Laman: www.contoh.sch.id|Pos-el: surat@contoh.sch.id'
LOGO = 'logo.png'

# Penandatangan surat
TTD_JABATAN = 'Kepala SMP Negeri Contoh'
TTD_NAMA = 'Nama Kepala Sekolah, S.Pd., M.Pd.'
TTD_NIP = '000000000000000000'
TTD_PANGKAT = 'Pembina Tingkat I (IV/b)'

#--------------------------------------------------------------------
# PENOMORAN SURAT
# Penanda: {kode} {no} {no3} {romawi} {tahun}
#--------------------------------------------------------------------
NOMOR_KODE = '421.3'
NOMOR_FORMAT = '{kode}/{no3}/{romawi}/{tahun}'
NOMOR_FORMAT_DOK = '{kode} / {no} / {tahun}'
